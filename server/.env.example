# Copy to .env and fill in. The server validates these at startup and refuses
# to boot with a clear message rather than failing later on a request.

# HTTP
NODE_ENV=development
PORT=5000

# Auth. At least 16 characters, and different in every environment.
JWT_SECRET=
JWT_EXPIRES_IN=90d

# Web client origin. Used for CORS and for links inside invite and reset emails.
CLIENT_URL=http://localhost:5173

# Extra allowed origins, comma separated. Leave empty in production.
CORS_ORIGINS=http://localhost:8081,http://localhost:8082

# How many proxies sit in front of the API. Render adds one; 0 when running
# with nothing in front. Decides which address the rate limiters count.
TRUST_PROXY=1

# Database
MONGO_URI=

# Only if the network cannot resolve the SRV/TXT records a mongodb+srv URI
# needs. Comma separated, empty otherwise.
DNS_SERVERS=

# Transactional email
BREVO_API_KEY=
