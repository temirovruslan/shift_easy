# The engines field in each package.json is a statement about which Node
# version this code is tested on. Without this it is a suggestion npm prints
# and ignores; with it, an install on the wrong major fails instead of
# producing a build that behaves differently from CI.
engine-strict=true

# Fail rather than hang when a registry is unreachable, so a broken network
# in CI reads as a broken network.
fetch-retries=2
fetch-timeout=60000
